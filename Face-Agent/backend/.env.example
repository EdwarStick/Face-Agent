# ──────────────────────────────────────────────────────────────────────────────
# FaceAttendance AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="FaceAttendance AI"
APP_VERSION="0.1.0"
APP_ENV="development"          # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"
SECRET_KEY="change-me-in-production-use-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=faceattendance

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React frontend
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Azure AI (future integration) ─────────────────────────────────────────────
AZURE_SUBSCRIPTION_KEY=
AZURE_ENDPOINT=
AZURE_REGION=

# ── Face Recognition Settings (future) ───────────────────────────────────────
FACE_DETECTION_MODEL="opencv"   # opencv | retinaface | mtcnn
FACE_RECOGNITION_MODEL="Facenet512"
FACE_SIMILARITY_THRESHOLD=0.40
